# Copy to .env and fill in.

# --- Splunk Observability Cloud ---
SPLUNK_REALM=us1
# Ingest token (needs INGEST scope)
SPLUNK_ACCESS_TOKEN=changeme

# --- Splunk Enterprise (HEC) for application logs ---
SPLUNK_HEC_URL=https://splunk.example.com:8088
SPLUNK_HEC_TOKEN=changeme
SPLUNK_HEC_INDEX=o11y_demo
# true if HEC uses a self-signed certificate
SPLUNK_HEC_TLS_INSECURE=false

# --- Naming ---
SERVICE_NAME=shop-app
DEPLOYMENT_ENV=o11y-demo
# host.name used for every signal, so APM correlates with host/process metrics
DEMO_HOST_NAME=o11y-demo-host

# --- Runtime knobs ---
# CPU core(s) shared by the app and the noisy neighbor (e.g. "0" or "0,1")
DEMO_CPUSET=0
# Failure scenarios switch themselves off after this many minutes (0 = never)
CHAOS_AUTO_OFF_MINUTES=30
# Orders placed by the load generator are deleted after this many minutes
DB_RETENTION_MINUTES=60
# Background traffic multiplier (1 = ~17 req/s)
LOAD_MULTIPLIER=1
# Host port for the app and the /chaos/ control page (container port is 8080).
# Use "127.0.0.1:52731" to keep it off the network and reach it through an SSH/SSM tunnel.
APP_PORT=52731
